# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
MANIFEST

# ── Virtual environment ─────────────────────────────────────────────────
.venv/
venv/
env/

# ── IDE / Editor ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Environment files ───────────────────────────────────────────────────
.env
.env.local
.env.production
.env.development

# ── Reticulum Beacon runtime data ───────────────────────────────────────
# Config, identities, certs, and audit logs are generated at runtime
# in ~/.beacon/ — never commit them.
.beacon/

# ── Static assets (downloaded at runtime into the package) ──────────────
src/reticulum_beacon/static/*.js
src/reticulum_beacon/static/*.css
!src/reticulum_beacon/static/__init__.py
!src/reticulum_beacon/static/download.py
# Legacy location (pre-1.0 repo-root static/)
static/*.js
static/*.css
!static/__init__.py
!static/download.py

# ── Systemd (example template kept, installed service file not) ─────────
systemd/*.service
!systemd/*.service.example

# ── Test / Coverage ─────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── mypy / ruff ─────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# AI session artifacts
.sandbox-home/
.claw/
.omo/
.clawd-todos.json
