# ═══════════════════════════════════════════════════════════════════════════
# Reticulum Beacon — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then start the beacon:
#   docker compose up -d
#
# Or run locally:
#   export $(grep -v '^#' .env | xargs)
#   beacon api start
# ═══════════════════════════════════════════════════════════════════════════

# ── API Server ──────────────────────────────────────────────────────────

# API authentication bearer token.
# If empty, a random 32-char hex key is auto-generated on first run and
# printed to the startup log. Set this to a strong secret in production.
# BEACON_API_KEY=your-strong-secret-key-here

# CORS allowed origins (comma-separated).
# Default: http://127.0.0.1, http://localhost
# Override if accessing the API from other origins (e.g., a reverse proxy).
# BEACON_CORS_ORIGINS=http://127.0.0.1:8931,http://my-domain.com

# Port for the API server (only used with docker-compose).
# Default: 8931
# BEACON_PORT=8931

# ── AI Bot (optional) ──────────────────────────────────────────────────

# API key for the AI bot's inference provider.
# If empty, the AI bot attempts local inference at BEACON_AI_API_URL.
# BEACON_AI_API_KEY=sk-your-api-key

# API endpoint URL for the AI bot's inference provider.
# Default: http://localhost:11434/v1/chat/completions (Ollama)
# BEACON_AI_API_URL=http://localhost:11434/v1/chat/completions

# Model name for the AI bot.
# Default: llama3.2
# BEACON_AI_MODEL=llama3.2

# Message prefix that triggers the AI bot.
# Default: /ai
# Messages starting with this prefix will be processed by the AI bot.
# BEACON_AI_PREFIX=/ai

# Custom TLS certificate and key paths are configured via CLI flags:
#   beacon api start --cert /path/to/cert.pem --key /path/to/key.pem
